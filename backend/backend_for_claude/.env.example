# backend/.env.example
# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public URL of the API (used to build payment return URLs)
API_PUBLIC_URL=http://localhost:3000
# Public URL of the frontend (used for CORS, password reset emails, redirects)
WEB_PUBLIC_URL=http://localhost:4200

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://gallery:gallery@localhost:5432/gallery_db

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_COST=12

# ─── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_ROOT=/var/www/gallery/uploads
# Max single image upload (bytes). 20 MB.
UPLOAD_MAX_BYTES=20971520

# ─── Mail (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Art Gallery <noreply@example.com>"

# ─── Ameriabank vPOS ────────────────────────────────────────────────────────
# See backend/src/payments/ameriabank/ameriabank.README.md for onboarding.
AMERIABANK_BASE_URL=https://servicestest.ameriabank.am/VPOS/api/VPOS
AMERIABANK_CLIENT_ID=
AMERIABANK_USERNAME=
AMERIABANK_PASSWORD=
# Where the bank redirects the customer after payment. Must be HTTPS in prod.
AMERIABANK_RETURN_URL=http://localhost:3000/api/payments/ameriabank/return
