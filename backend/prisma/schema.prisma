// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Locale {
  EN
  HY
  RU
}

enum OrderStatus {
  PENDING      // created, awaiting payment redirect
  PAID         // bank confirmed payment
  FAILED       // payment failed or cancelled at bank
  FULFILLED    // admin marked as shipped/delivered
  CANCELLED    // admin or user cancelled
  REFUNDED
}

enum PaymentProvider {
  AMERIABANK
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FrameType {
  NONE
  WOOD
  METAL
  PLASTIC
}

// ─────────────────────────────────────────────────────────────────────────────
//  USERS & AUTH
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  phone         String?
  role          UserRole     @default(USER)
  status        UserStatus   @default(ACTIVE)
  locale        Locale       @default(EN)   // preferred UI language

  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]
  cartItems     CartItem[]
  orders        Order[]
  wallPreviews  WallPreview[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([email])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Store the SHA-256 hash of the token, never the token itself.
  // If the DB leaks the tokens are still useless.
  tokenHash   String   @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model PasswordReset {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// ─────────────────────────────────────────────────────────────────────────────
//  CATALOG
// ─────────────────────────────────────────────────────────────────────────────

model Artist {
  id           String              @id @default(cuid())
  slug         String              @unique         // for SEO-friendly URLs later
  portraitPath String?                              // /uploads/artists/<id>/portrait.jpg
  birthYear    Int?
  deathYear    Int?
  artworks     Artwork[]
  translations ArtistTranslation[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ArtistTranslation {
  id        String  @id @default(cuid())
  artistId  String
  artist    Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  locale    Locale
  name      String
  bio       String? @db.Text

  @@unique([artistId, locale])
  @@index([locale, name])
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  artworks     Artwork[]
  translations CategoryTranslation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     Locale
  name       String

  @@unique([categoryId, locale])
  @@index([locale, name])
}

model Artwork {
  id            String                @id @default(cuid())
  slug          String                @unique
  artistId      String
  artist        Artist                @relation(fields: [artistId], references: [id])
  categoryId    String
  category      Category              @relation(fields: [categoryId], references: [id])

  // Physical attributes (locale-independent)
  year          Int?
  medium        String?                                // "Oil on canvas" — admin enters EN; translated copy in translations table
  widthCm       Decimal?              @db.Decimal(8, 2)
  heightCm      Decimal?              @db.Decimal(8, 2)

  basePrice     Decimal               @db.Decimal(12, 2)  // AMD, base price for cheapest print
  isAvailable   Boolean               @default(true)
  deletedAt     DateTime?                                  // soft delete

  images        ArtworkImage[]
  translations  ArtworkTranslation[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wallPreviews  WallPreview[]

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Hot query paths
  @@index([categoryId, isAvailable, deletedAt])
  @@index([artistId])
  @@index([createdAt])
}

model ArtworkTranslation {
  id          String   @id @default(cuid())
  artworkId   String
  artwork     Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  locale      Locale
  title       String
  description String?  @db.Text
  history     String?  @db.Text
  medium      String?  // optional localised override

  @@unique([artworkId, locale])
  @@index([locale, title])
}

model ArtworkImage {
  id            String   @id @default(cuid())
  artworkId     String
  artwork       Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  // Stored as paths relative to /uploads root; Nginx serves them directly.
  // Three sizes always generated together by Sharp at upload time.
  originalPath  String
  mediumPath    String
  thumbnailPath String
  // Width/height of the *original* — used to compute aspect ratio client-side
  // without needing to fetch the image.
  width         Int
  height        Int
  position      Int      @default(0)        // ordering when multiple images per artwork
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([artworkId, position])
}

// ─────────────────────────────────────────────────────────────────────────────
//  PRINT OPTIONS — admin-configurable
// ─────────────────────────────────────────────────────────────────────────────

model PrintSize {
  id            String                  @id @default(cuid())
  code          String                  @unique           // "A3", "50x70", etc — admin-defined
  widthCm       Decimal                 @db.Decimal(8, 2)
  heightCm      Decimal                 @db.Decimal(8, 2)
  // Price multiplier vs the artwork base price. e.g. 1.0 for default, 1.8 for large.
  priceMultiplier Decimal               @db.Decimal(6, 3)
  isActive      Boolean                 @default(true)
  position      Int                     @default(0)
  translations  PrintSizeTranslation[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model PrintSizeTranslation {
  id          String    @id @default(cuid())
  printSizeId String
  printSize   PrintSize @relation(fields: [printSizeId], references: [id], onDelete: Cascade)
  locale      Locale
  label       String

  @@unique([printSizeId, locale])
}

model FrameOption {
  id            String                    @id @default(cuid())
  code          String                    @unique          // "wood-oak", "metal-black"
  frameType     FrameType
  // Hex colour rendered in the wall preview and shown as a swatch in customization.
  colorHex      String
  // Flat additive price in AMD on top of the (artwork × size) cost.
  additionalPrice Decimal                 @db.Decimal(12, 2)
  isActive      Boolean                   @default(true)
  position      Int                       @default(0)
  translations  FrameOptionTranslation[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
}

model FrameOptionTranslation {
  id            String      @id @default(cuid())
  frameOptionId String
  frameOption   FrameOption @relation(fields: [frameOptionId], references: [id], onDelete: Cascade)
  locale        Locale
  label         String

  @@unique([frameOptionId, locale])
}

// ─────────────────────────────────────────────────────────────────────────────
//  CART
// ─────────────────────────────────────────────────────────────────────────────

model CartItem {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworkId     String
  artwork       Artwork      @relation(fields: [artworkId], references: [id], onDelete: Restrict)
  printSizeId   String
  printSize     PrintSize    @relation(fields: [printSizeId], references: [id], onDelete: Restrict)
  frameOptionId String?
  frameOption   FrameOption? @relation(fields: [frameOptionId], references: [id], onDelete: Restrict)
  withMatte     Boolean      @default(false)
  quantity      Int          @default(1)
  // Snapshotted at add time so price drift in admin doesn't silently change the cart.
  unitPrice     Decimal      @db.Decimal(12, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
//  ORDERS — once created, immutable history. OrderItem snapshots everything.
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  // Human-friendly reference number, e.g. "ORD-2026-000123" — generated in service.
  // Also used as the Ameriabank OrderID (must be unique per merchant).
  orderNumber     String        @unique
  userId          String?                                     // null = guest checkout (future)
  user            User?         @relation(fields: [userId], references: [id])

  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @db.Decimal(12, 2)            // AMD
  currency        String        @default("AMD")

  // Shipping (Armenia-focused; snapshot, not FK)
  shippingFirstName String
  shippingLastName  String
  shippingPhone     String
  shippingCity      String
  shippingAddress   String
  shippingNotes     String?

  // Payment summary — full attempt log lives in Payment
  paymentProvider PaymentProvider?
  paidAt          DateTime?

  items           OrderItem[]
  payments        Payment[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // FK retained for "view in catalog" links, but everything important is snapshotted
  // so deleting an artwork (soft-delete) doesn't corrupt history.
  artworkId       String?
  artwork         Artwork?     @relation(fields: [artworkId], references: [id])
  printSizeId     String?
  printSize       PrintSize?   @relation(fields: [printSizeId], references: [id])
  frameOptionId   String?
  frameOption     FrameOption? @relation(fields: [frameOptionId], references: [id])

  // SNAPSHOT — these are the source of truth for the order line, forever.
  artworkTitle    String
  artistName      String
  printSizeLabel  String
  frameLabel      String?
  withMatte       Boolean      @default(false)
  unitPrice       Decimal      @db.Decimal(12, 2)
  quantity        Int
  lineTotal       Decimal      @db.Decimal(12, 2)
  thumbnailPath   String?                                     // so order history shows image
                                                              // even if artwork is deleted

  createdAt       DateTime     @default(now())

  @@index([orderId])
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  status        PaymentStatus   @default(INITIATED)
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("AMD")
  // Provider-specific identifiers
  providerPaymentId String?                                   // Ameriabank PaymentID
  providerOrderId   String?                                   // OrderID we sent
  // Full provider responses for audit; queries should not depend on shape.
  rawInitResponse   Json?
  rawVerifyResponse Json?
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([orderId])
  @@index([providerPaymentId])
}

// ─────────────────────────────────────────────────────────────────────────────
//  WALL PREVIEWS — saved compositions
// ─────────────────────────────────────────────────────────────────────────────

model WallPreview {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworkId    String
  artwork      Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  // Path to the user's interior photo (private upload bucket)
  wallImagePath String
  // Composited PNG path; null until user saves
  compositePath String?
  // Position + frame config so the preview can be re-opened and tweaked
  config       Json
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
